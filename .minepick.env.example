# minepick configuration
# =======================
#
# Copy this file to one of the searched locations and fill in your keys:
#
#   cp .minepick.env.example .minepick.env
#   chmod 600 .minepick.env
#
# Search order (first file found wins; keys are only loaded from ONE file):
#   1. $MINEPICK_ENV            (explicit path, overrides everything)
#   2. ~/.minepick.env
#   3. .minepick.env next to minepick.py
#   4. ./.minepick.env (current working directory)
#
# Real environment variables always override this file. Format is KEY=VALUE,
# one per line; lines starting with # are comments; values may be quoted with
# single or double quotes (quotes are stripped).
#
# Keep this file out of any repo — it holds your API keys.


# ---- REQUIRED: hashrate.no API key -----------------------------------------
#
# Get one at: https://www.hashrate.no/c/api
# The free tier is quota-limited per month. minepick mitigates this with a disk
# cache and by making as few API calls as possible (see README), but a paid
# plan removes the ceiling.
#
# Example (fake):
# HASHRATE_NO_API_KEY=hrn_1234567890abcdef1234567890abcdef

HASHRATE_NO_API_KEY=


# ---- HiveOS personal API key (needed for --hive) ---------------------------
#
# Create one at: https://api2.hiveos.farm (Personal settings -> API Keys).
# This must be a *personal* key with access to your farms. If some farms only
# have monitor-role access, minepick falls back to per-worker detail fetches
# for those and reports unauthorized farms in `skipped_farms`.
#
# Note: HiveOS responses are NEVER cached — flight sheets change, and the
# live join must reflect what rigs are actually mining right now.
#
# Example (fake):
# HIVEOS_API_KEY= hive_personal_key_abcd1234efgh5678

HIVEOS_API_KEY=


# ---- Power cost ($/kWh) ----------------------------------------------------
#
# Default power cost used everywhere cost isn't passed explicitly.
# `--cost 0.10` on the command line overrides this for a single run.
# If unset, minepick defaults to 0.10 internally.
#
# Examples:
#   0.08  -> 8 cents per kWh (cheap industrial / personal solar)
#   0.32  -> 32 cents per kWh (typical EU residential)
POWER_COST=0.08


# ---- Farms filter ----------------------------------------------------------
#
# Comma-separated farm IDs or farm-name substrings to include when running
# `--hive`. Case-insensitive substring match on the farm name; numeric values
# are matched against farm IDs. Leave unset to scan ALL farms on the account.
#
# `--farm` on the command line overrides this.
#
# Examples:
#   FARMS=4397082                  # one farm by ID
#   FARMS=OctoOnly,GPU Datacenter  # two farms by name substring
#   FARMS=1147851,4397082          # by ID, comma separated
FARMS=


# ---- Preferred coins -------------------------------------------------------
#
# THE KEY THAT FIXES CUSTOM HASHRATES. Comma-separated coin tickers that you
# actually mine (or are considering). For each coin here, minepick makes ONE
# extra call to hashrate.no's per-coin estimate endpoint
# (?coin=TICKER&powerCost=...) — the only place hashrate.no reports YOUR
# account-level custom hashrates — and keeps whichever profit is higher than
# the generic benchmark-based estimate for each device.
#
# Additionally, for devices with no estimate row for a preferred coin (linear
# per-hashrate algos), minepick derives it locally:
#   revenue = yield_per_hash * your_hashrate * coin_price
#   profit  = revenue - watts * 24/1000 * POWER_COST
# using one unfiltered /coins fetch (prices) and one /benchmarks?coin= fetch
# (benchmark hashrates/watts) — cached, so repeated runs cost nothing.
#
# Examples:
#   COINS=PRL,QUAN,EPIC,QTC    # Pearl, Quantus, Epic Cash, Qubitcoin
#   COINS=ETHW                 # just one
COINS=


# ---- Device model aliases --------------------------------------------------
#
# Comma-separated "HiveOS Name=hashrate.no Model" pairs, used when the fuzzy
# slug matching can't map a HiveOS GPU model name to a hashrate.no device.
# Matching is done on the normalized slug of both sides (lowercase, brand
# words like nvidia/geforce/rtx stripped, non-alphanumerics removed).
#
# Example: HiveOS reports "CMP 170HX 8GB" but hashrate.no calls it "CMP 170HX":
#   MODEL_ALIASES=CMP 170HX 8GB=CMP 170HX,CMP-HX-100=CMP 100-210
#
# You rarely need this — there is a built-in SLUG_FIXES table for common
# HiveOS names (RTX 4090, CMP 170HX, A2000, V100 SXM, Radeon, ...). Anything
# still unmatched shows up in the `unmatched_models` output; add an alias
# for those.
MODEL_ALIASES=


# ---- Local overrides (ground truth beats estimates) ------------------------
#
# Comma-separated entries. TWO forms:
#
#   1) "Device Name=COIN=hashrate=power_W"   (preferred, replicates the
#      hashrate.no calculator)
#      coins/day = yield_per_hash * hashrate      (linear per-algo yield)
#      revenue   = coins/day * coin_price
#      cost/day  = power_W * 24 / 1000 * POWER_COST
#      profit    = revenue - cost/day
#      The hashrate.no yield-per-hashrate and price are fetched once and
#      cached. Use your REAL overclocked hashrate and wall watts here.
#
#   2) "Device Name=COIN=profit_per_day"     (legacy — you already know the
#      profit; no API math needed)
#
# The device name is slug-matched the same way HiveOS names are, so both the
# raw and fixed slugs get the override. Overrides beat everything.
#
# Examples:
#   OVERRIDES=My OC 5090=PRL=1350000000=430,cmp170hx8gb=QUAN=14000000=245
#   OVERRIDES=weird-gpu=PRL=12.50            (legacy: $12.50/day profit)
OVERRIDES=


# ---- Octominer / chassis rigs (wall-power allocation) ----------------------
#
# Comma-separated rig-name regexes. For matching rigs, the rig's WALL power
# draw (from HiveOS rig stats, which includes fans + PSU inefficiency + any
# non-GPU hardware) is allocated proportionally to each GPU's power share
# before computing live profit — so per-GPU profit reflects the whole box,
# not just the cards.
#
# Applied ONLY when rig wall power > sum of per-GPU power readings.
#
# Examples:
#   OCTOMINERS=airbox,cmp-100,hive-cmp-100-210
#   OCTOMINERS=octo                          (matches any rig with 'octo' in the name)
OCTOMINERS=


# ---- Live stats toggle -----------------------------------------------------
#
# 1 (default)  = poll online rigs for live hashrate + power (one worker-detail
#                call per online rig; live profit shown as "live" in the table)
# 0            = skip live polling entirely (same as --no-live-stats) — faster,
#                fewer HiveOS calls, but $/day becomes estimate-only
LIVE_STATS=1


# ---- Include offline rigs --------------------------------------------------
#
# 0 (default) = online rigs only
# 1           = include offline rigs (same as --offline)
OFFLINE=0
